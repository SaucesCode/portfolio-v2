# Optional. Origin used for canonical URLs, the sitemap, structured data and social images.
# Defaults to the production domain in src/data/site.ts; set it only for a copy served elsewhere.
NEXT_PUBLIC_SITE_URL=

# --- "Ask this site" assistant ---------------------------------------------------------------
# Gemini API key from Google AI Studio. Keep the project on the free tier (no billing).
GEMINI_API_KEY=
# Optional: model and API base (defaults: gemini-3.5-flash-lite, https://generativelanguage.googleapis.com).
GEMINI_MODEL=
GEMINI_BASE_URL=
# Counter store for the limits. Set automatically by Vercel's Upstash Redis integration
# (either the UPSTASH_* or the KV_* names). Without a store the assistant stays off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local runs and tests only: count in memory instead of Redis.
ASSISTANT_STORE=
# Extra origins allowed to call /api/ask, comma separated (for example http://localhost:3001).
ASSISTANT_ALLOWED_ORIGINS=
# Set to false to switch the assistant off at the next deploy. For an instant switch, set the
# Redis key assistant:enabled to 0 in the Upstash console.
ASSISTANT_ENABLED=
